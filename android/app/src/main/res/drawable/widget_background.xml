<?xml version="1.0" encoding="utf-8"?>
<!-- Navy gradient card with a subtle gold hairline, matching the app
     header + OG cards. System auto-rounds widgets on Android 12+, but a
     radius here keeps older releases on-brand too. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#1D2843"
        android:endColor="#121A2A"
        android:angle="270" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#33C4A25D" />
</shape>
