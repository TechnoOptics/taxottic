<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for the native <select> picker's AlertDialog.

     Deliberately DARK. Every page that opens this picker (transactions,
     categories, forecast filters) is the dark authenticated UI on
     #121a2a, so a white sheet flashes hard against it. It also has to be
     dark for the text to be legible at all: AppTheme.AlertDialog inherits
     android:Theme.DeviceDefault.Dialog.Alert, the DARK DeviceDefault
     variant, whose list-item text colour is near-white. The previous
     @android:color/white windowBackground was therefore white-on-white,
     survivable only because the splash bitmap happened to be painted over
     it. #1d2843 is the brand colorPrimary, one step lighter than the
     #121a2a page behind, so the picker reads as a raised surface.

     An <inset> is used rather than a bare colour so the panel keeps
     normal dialog margins instead of butting against the window edge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetRight="8dp"
    android:insetTop="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="#1d2843" />
        <corners android:radius="16dp" />
    </shape>
</inset>
