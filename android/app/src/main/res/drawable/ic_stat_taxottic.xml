<!--
  Status-bar / notification small icon. Android renders notification
  small icons as a flat monochrome silhouette (white, system-tinted)
  on a TRANSPARENT background — so this is the Taxottic "T" monogram
  as a single white shape, with no navy tile behind it. Previously the
  @capgo/background-geolocation foreground-service notification fell
  back to mipmap/ic_launcher (the full navy+gold tile), which showed
  as a colored badge with a background in the status bar — unlike every
  other app. The "T" path matches public/icon.svg (the web favicon).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,22 h32 v6 H36 v22 h-8 V28 H16 z" />
</vector>
