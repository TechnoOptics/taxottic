<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Post-splash theme Capacitor's BridgeActivity switches to.
         Brand dark green (#0a1f19) is the WINDOW background AND the
         status/navigation bar colours so there is never a white
         strip: pre-Android-15 the bars are coloured directly; on
         Android 15 (edge-to-edge enforced, bar colours ignored) the
         window background is what shows behind the transparent bars
         and around the WebView — making it #0a1f19 is what actually
         removes the white top/bottom bands. windowLight*Bar=false
         keeps the clock/battery/nav glyphs WHITE on the dark green.
         The web app owns content insets via env(safe-area-inset-*),
         so edge-to-edge is correct. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0a1f19</item>
        <item name="android:statusBarColor">#0a1f19</item>
        <item name="android:navigationBarColor">#0a1f19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>


    <!-- Launch/splash theme. Window background stays the branded
         splash drawable (already #0a1f19); colour the bars dark too
         so there's no white flash before the WebView paints. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#0a1f19</item>
        <item name="android:navigationBarColor">#0a1f19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
