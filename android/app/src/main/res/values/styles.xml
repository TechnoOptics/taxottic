<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Post-splash theme Capacitor's BridgeActivity switches to.
         Brand dark green (#121a2a) is the WINDOW background AND the
         status/navigation bar colours so there is never a white
         strip: pre-Android-15 the bars are coloured directly; on
         Android 15 colours: window background #121a2a (shows behind
         the bars) + white glyphs, so there's never a white strip.

         windowOptOutEdgeToEdgeEnforcement=true: Android 15 (API 35)
         FORCES edge-to-edge for targetSdk 35, which makes the WebView
         draw under the status bar. The Android WebView reports
         env(safe-area-inset-top)=0, so the header rendered on top of
         the clock/battery ("header overlapping the notification
         bar"); StatusBar.setOverlaysWebView(false) is ignored under
         forced edge-to-edge (confirmed in logcat on an API-35
         emulator). This official opt-out restores normal insets so
         the OS reserves the status-bar strip and the header starts
         below it. Valid until we target SDK 36 / handle insets
         natively; harmless/ignored on pre-15. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#121a2a</item>
        <item name="android:statusBarColor">#121a2a</item>
        <item name="android:navigationBarColor">#121a2a</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <!-- Launch/splash theme. Window background stays the branded
         splash drawable (already #121a2a); colour the bars dark too
         so there's no white flash before the WebView paints. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#121a2a</item>
        <item name="android:navigationBarColor">#121a2a</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
