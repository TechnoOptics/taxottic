<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Native OAuth handoff. Supabase redirects the in-app
                 browser tab to com.taxottic.app://auth-callback after
                 sign-in; this filter routes that custom scheme back
                 into MainActivity (launchMode singleTask), Capacitor
                 fires appUrlOpen, and the WebView completes the
                 session. Without it the OAuth session strands in the
                 system browser. The scheme must also be allow-listed
                 in Supabase Auth -> URL Configuration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.taxottic.app"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Push (FCM) notification small icon. Without this,
             @capacitor/push-notifications uses the full launcher tile as
             the status-bar icon (a colored badge with a background). Use
             the same transparent white "T" silhouette as the mileage
             foreground-service notification so every Taxottic
             notification shows a clean, background-less glyph like a
             standard app. Only consumed when FCM is configured. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_taxottic" />

        <!-- Home-screen forecast widget. exported=true so the launcher /
             widget host can bind it. Reads the snapshot that
             TaxotticWidgetBridgePlugin persists; no network of its own. -->
        <receiver
            android:name=".TaxotticForecastWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_forecast_info" />
        </receiver>

        <!-- Learned-place geofence mesh: the resurrection net for the
             confirmed "first drive of the day is never recorded" bug.

             The phone sits at home overnight with the app backgrounded,
             the OS reclaims the process (or Samsung's sleeping-apps
             state restricts it), nothing re-arms the foreground
             service, and the morning commute is lost. A geofence is
             delivered by the platform to a process it starts for the
             purpose, so driving off the driveway restarts capture with
             nothing of ours having survived the night.

             exported="false" is correct and not a mistake: Play
             services delivers via our own PendingIntent, which does not
             require the component to be exported. -->
        <receiver
            android:name=".TaxotticGeofenceReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Geofence registrations do NOT survive a reboot, and they do
             NOT survive an app update. Both re-arm here. The update case
             is the one most easily forgotten, because it only bites on
             the release after the one you tested: users have no reason
             to open the app after an automatic Play update. -->
        <receiver
            android:name=".TaxotticGeofenceBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Started ONLY by a geofence exit, and only when background
             location is genuinely granted.

             PLAY POLICY: Google removed "geofencing" as an approved
             foreground-service use case in April 2026, directing
             developers to the Geofence API. That is what this is. The
             geofencing itself is done by GeofencingClient with no
             service at all; this service is started BY that trigger and
             does vehicle activity tracking, which is an explicitly
             named approved location foreground-service use case in
             Play's requirements effective 26 August 2026. Do not
             relabel it, and do not move region monitoring inside it. -->
        <service
            android:name=".TaxotticResurrectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: @capacitor/camera is installed for receipt capture.
         The matching uses-feature is required="false" so Google Play
         does NOT filter the app off camera-less devices (camera is
         value-add, not core to the WebView shell). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Push notifications: @capacitor/push-notifications is
         installed for tax-deadline reminders. POST_NOTIFICATIONS is
         REQUIRED on Android 13+ (API 33+) — without it the app
         silently fails to show any notification on modern devices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background mileage capture (@capgo/background-geolocation).
         Continuous drive logging runs as a foreground service with a
         persistent notification. On Samsung (and other aggressive
         OEMs) the foreground service alone isn't enough — the OS
         throttles location updates to once-every-many-minutes
         unless ACCESS_BACKGROUND_LOCATION is granted. Without it,
         drives get truncated or skipped entirely when the user
         pockets their phone. Play review adds a heightened bar for
         this permission; the disclaimer paragraph on /mileage
         covers the use case (mileage deduction only). Updated
         May 2026 after the Galaxy Z Fold5 demo confirmed the
         foreground-only approach wasn't actually working.

         FOREGROUND_SERVICE_LOCATION is the typed permission
         Android 14+ (API 34) requires for a location-type
         foreground service.

         NOTE: we previously also declared ACTIVITY_RECOGNITION
         (intended to tell driving apart from walking), but nothing
         ever used it — the @capgo background-geolocation plugin
         doesn't request it, and the eco-mode "is this a real
         drive?" gate is done purely with the GPS distanceFilter,
         not the Activity Recognition API. It was removed so the
         app no longer triggers Google Play's Health-apps
         declaration, which fires on that permission. -->
    <!-- ACTIVITY_RECOGNITION is deliberately NOT declared.

         It was re-added for walk-away drive-end detection (the step
         counter needs it on API 29+), but Google Play then refuses the
         release outright: "You must let us know whether your app
         includes any health features." The Health-apps declaration IS
         on file and correctly says Taxottic has none - Play still
         rejects any binary shipping this permission alongside that
         answer, and the only way through would be to declare an
         "Activity and fitness" health feature we do not have. We will
         not file a false declaration to ship a convenience feature.

         Consequence: on Android, walk-away closing degrades to the
         6-minute stationary fallback in lib/mileage/drive-end.ts (the
         JS bridge already returns 0 steps when the plugin method is
         absent, so this is a supported path, not a break). iOS keeps
         full walk-away via CMPedometer, which no store policy gates.

         The native step-counter code is retained but inert, so
         restoring this is a one-line change if Play's stance changes
         or a GPS-displacement walk-away signal replaces the sensor. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Re-arm the learned-place geofence mesh after a reboot
         (TaxotticGeofenceBootReceiver). The @capgo plugin's manifest
         happens to declare this too and the merger would supply it, but
         a permission our own receiver depends on must not be inherited
         from a dependency that could drop it in any future version. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Battery-exemption request dialog (mileage tracking breaks under
         Doze; Google's acceptable-use list covers this case). The setup
         wizard drives it; the policy-safe settings-list intent is the
         fallback. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
