<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Native OAuth handoff. Supabase redirects the in-app
                 browser tab to com.taxottic.app://auth-callback after
                 sign-in; this filter routes that custom scheme back
                 into MainActivity (launchMode singleTask), Capacitor
                 fires appUrlOpen, and the WebView completes the
                 session. Without it the OAuth session strands in the
                 system browser. The scheme must also be allow-listed
                 in Supabase Auth -> URL Configuration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.taxottic.app"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: @capacitor/camera is installed for receipt capture.
         The matching uses-feature is required="false" so Google Play
         does NOT filter the app off camera-less devices (camera is
         value-add, not core to the WebView shell). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Push notifications: @capacitor/push-notifications is
         installed for tax-deadline reminders. POST_NOTIFICATIONS is
         REQUIRED on Android 13+ (API 33+) — without it the app
         silently fails to show any notification on modern devices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background mileage capture (@capgo/background-geolocation).
         Continuous drive logging runs as a foreground service with a
         persistent notification. On Samsung (and other aggressive
         OEMs) the foreground service alone isn't enough — the OS
         throttles location updates to once-every-many-minutes
         unless ACCESS_BACKGROUND_LOCATION is granted. Without it,
         drives get truncated or skipped entirely when the user
         pockets their phone. Play review adds a heightened bar for
         this permission; the disclaimer paragraph on /mileage
         covers the use case (mileage deduction only). Updated
         May 2026 after the Galaxy Z Fold5 demo confirmed the
         foreground-only approach wasn't actually working.

         FOREGROUND_SERVICE_LOCATION is the typed permission
         Android 14+ (API 34) requires for a location-type
         foreground service. ACTIVITY_RECOGNITION lets the plugin
         tell driving apart from walking/cycling/stationary, so
         trips < 200 m at walking pace are filtered before they
         even reach the segmenter. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
