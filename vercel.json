{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/plaid-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/stripe-sync",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/firm-digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/firm-invoice-issue",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/oauth-refresh",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/firm-activity-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/mileage-finalize",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/outstanding-reminders",
      "schedule": "0 14 * * *"
    }
