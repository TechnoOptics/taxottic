# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Bella AI)
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# OAuth (we run the dance on our own domain so the consent screen reads
# "to continue to taxottic.com" instead of the Supabase project URL).
# Add https://taxottic.com/api/auth/google/callback as an authorized redirect
# URI on the SAME Google OAuth client you already gave to Supabase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Add https://taxottic.com/api/auth/azure/callback as a redirect URI on the
# SAME Azure / Entra app registration you already gave to Supabase.
AZURE_OAUTH_CLIENT_ID=
AZURE_OAUTH_CLIENT_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (transactional)
# Resend API key — required for firm-branded invitation emails sent
# from the enterprise portal (Phase 3+). Without it, the firm-invite
# transport falls back to a no-op that logs to the server console.
# Sign up at https://resend.com, verify the taxottic.com domain, and
# paste the key here. Per-firm from-addresses use the firm's name as
# the display-name; the address itself stays on the verified
# taxottic.com domain.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@taxottic.com

# Enterprise portal — destination for firm invitation magic-links
# emailed via Supabase's OTP fallback. Used by lib/email/send-firm-invite.ts
# when the super-admin approves a firm access request.
ENTERPRISE_SITE_URL=https://enterprise.taxottic.com

# Cron auth — Vercel sets `x-vercel-cron: 1` automatically. CRON_SECRET
# is the bearer token for manually triggering cron routes (debug + retry).
# Used by /api/cron/plaid-sync and /api/cron/firm-digest.
CRON_SECRET=

# E-signature: Documenso (self-host, default for all firm tiers)
# Sign up + deploy your Documenso instance, then paste the v1 REST API
# URL and bearer token. Without both, e-signature gracefully degrades
# to "download the document and sign manually" mode.
DOCUMENSO_API_URL=
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# E-signature: DocuSign (enterprise tier only)
# DOCUSIGN_API_KEY is the JWT-issued bearer token (cached in-module
# for 1h). Full JWT-grant wiring lands when an enterprise-tier firm
# needs it; until then we accept a pre-issued token.
DOCUSIGN_API_BASE=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_API_KEY=

# Scheduling: Zoom OAuth (firm preparers connect their personal
# Zoom accounts to auto-mint meeting URLs from inside the cockpit).
# Configure at https://marketplace.zoom.us with `meeting:write` scope.
# Redirect URI: https://taxottic.com/api/oauth/zoom/callback
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# Scheduling: Google Calendar. Re-uses the Google OAuth client above;
# add `https://www.googleapis.com/auth/calendar.events` to the granted
# scopes and /api/oauth/google-calendar/callback as an authorized URI.
GOOGLE_CALENDAR_REDIRECT_PATH=/api/oauth/google-calendar/callback

# Scheduling: Microsoft Teams. Re-uses the Azure client above; add
# OnlineMeetings.ReadWrite + Calendars.ReadWrite to the application
# permissions.
MS_GRAPH_REDIRECT_PATH=/api/oauth/microsoft-graph/callback

# Payments: Stripe Connect (Phase 7).
# Re-uses the existing STRIPE_SECRET_KEY (consumer Stripe key). The
# Connect dashboard at https://dashboard.stripe.com/settings/connect
# must be configured for Express accounts. Set the webhook endpoint
# at /api/webhooks/stripe-connect; the secret it returns goes in
# STRIPE_CONNECT_WEBHOOK_SECRET. Application-fee routing requires
# the platform Stripe account to be in good standing.
STRIPE_CONNECT_WEBHOOK_SECRET=

# OAuth token vault (Phase 10.5). AES-256-GCM key for encrypting
# OAuth tokens stored in firm_calendar_integrations. Accepts a
# 64-hex-char string, a 44-char base64 string, or any passphrase
# (hashed with SHA-256 to derive a 32-byte key). When unset we
# fall back to SUPABASE_SERVICE_ROLE_KEY which is non-ideal —
# rotate to a dedicated key for production.
OAUTH_TOKEN_VAULT_KEY=

# OAuth state-signing secret (Phase 10). Same fallback as the
# vault key. Used to sign the JWT we attach to OAuth `state`
# params so callbacks can verify the flow against the originating
# session.
OAUTH_STATE_SECRET=

# Vercel API access for BYO custom domain (Phase 2.5). Generate
# a Personal or Team token at vercel.com/account/tokens. Scope:
# domains:write + projects:read for the Taxottic project.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ---------------------------------------------------------------------
# Google Maps. Powers three things, all optional + degrade cleanly
# when unset (interactive map → "not configured" panel, address field
# → plain text input, trip thumbnail → hidden):
#   1. Mileage trip route maps   (Maps JavaScript API)
#   2. Business address autocomplete (Places library, same JS key)
#   3. Trip list thumbnails      (Maps Static API, same JS key)
#
# Put your key in .env.local (gitignored — NEVER commit it) AND in the
# Vercel project env for production. NEXT_PUBLIC_* is exposed to the
# browser by design; it is made safe by RESTRICTING it in Google Cloud
# Console, not by hiding it:
#   - Application restriction: HTTP referrers =
#       https://taxottic.com/*  and the Capacitor WebView origin
#   - API restriction: Maps JavaScript API + Maps Static API only
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
#
# Server-side Places (New) API for the find-a-CPA card. Separate key,
# NOT NEXT_PUBLIC (never reaches the browser). Restrict by IP or leave
# unrestricted-but-API-limited to the Places API. Optional: unset →
# the card falls back to a plain "open in Google Maps" link.
GOOGLE_PLACES_API_KEY=
