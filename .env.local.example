# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Bella AI)
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# OAuth (we run the dance on our own domain so the consent screen reads
# "to continue to taxottic.com" instead of the Supabase project URL).
# Add https://taxottic.com/api/auth/google/callback as an authorized redirect
# URI on the SAME Google OAuth client you already gave to Supabase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Add https://taxottic.com/api/auth/azure/callback as a redirect URI on the
# SAME Azure / Entra app registration you already gave to Supabase.
AZURE_OAUTH_CLIENT_ID=
AZURE_OAUTH_CLIENT_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (transactional)
# Resend API key — required for firm-branded invitation emails sent
# from the enterprise portal (Phase 3+). Without it, the firm-invite
# transport falls back to a no-op that logs to the server console.
# Sign up at https://resend.com, verify the taxottic.com domain, and
# paste the key here. Per-firm from-addresses use the firm's name as
# the display-name; the address itself stays on the verified
# taxottic.com domain.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@taxottic.com

# Enterprise portal — destination for firm invitation magic-links
# emailed via Supabase's OTP fallback. Used by lib/email/send-firm-invite.ts
# when the super-admin approves a firm access request.
ENTERPRISE_SITE_URL=https://enterprise.taxottic.com
