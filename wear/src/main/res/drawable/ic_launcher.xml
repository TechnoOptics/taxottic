<!-- Taxottic Wear launcher icon. The manifest previously pointed at
     @android:drawable/sym_def_app_icon (a framework drawable), so the
     bundle shipped NO real icon and Play rejected the Wear AAB
     ("APK does not contain an icon"). This is a self-contained
     vector — navy field + the gold Taxottic "T" mark — used for both
     android:icon and android:roundIcon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Brand navy, full-bleed (the launcher applies its own mask). -->
    <path
        android:fillColor="#121A2A"
        android:pathData="M0,0 H108 V108 H0 Z" />
    <!-- Gold "T": top bar + stem. -->
    <path
        android:fillColor="#D5BB7E"
        android:pathData="M26,32 H82 V46 H26 Z" />
    <path
        android:fillColor="#D5BB7E"
        android:pathData="M47,32 H61 V84 H47 Z" />
</vector>
