<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Taxottic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Export compliance: the app uses only standard HTTPS/TLS,
	     which is exempt encryption. Declaring false here removes the
	     manual export-compliance question on every App Store Connect
	     submission. If you ever add non-exempt cryptography, flip
	     this and file the required French/US documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Camera + photo-library usage strings. @capacitor/camera is
	     installed (receipt capture). iOS hard-crashes + App Review
	     auto-rejects if the camera/photo APIs are reachable without
	     these purpose strings. Wording is user-facing — keep it
	     specific about WHY. -->
	<key>NSCameraUsageDescription</key>
	<string>Taxottic uses the camera so you can photograph receipts and tax documents to attach them to your books.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Taxottic accesses your photo library so you can attach an existing receipt or tax-document image to your books.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Taxottic saves a copy of captured receipts to your photo library when you choose to keep one.</string>
	<!-- Custom URL scheme for the native OAuth handoff. Supabase
	     redirects the in-app browser tab to
	     com.taxottic.app://auth-callback after sign-in; the OS routes
	     that scheme back into the app, Capacitor fires appUrlOpen,
	     and the WebView completes the session. Without this the OAuth
	     session strands in the system browser. The scheme must also
	     be allow-listed in Supabase Auth -> URL Configuration. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.taxottic.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.taxottic.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
