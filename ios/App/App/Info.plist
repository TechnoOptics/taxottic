<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Taxottic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Export compliance: the app uses only standard HTTPS/TLS,
	     which is exempt encryption. Declaring false here removes the
	     manual export-compliance question on every App Store Connect
	     submission. If you ever add non-exempt cryptography, flip
	     this and file the required French/US documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Camera + photo-library usage strings. @capacitor/camera is
	     installed (receipt capture). iOS hard-crashes + App Review
	     auto-rejects if the camera/photo APIs are reachable without
	     these purpose strings. Wording is user-facing — keep it
	     specific about WHY. -->
	<key>NSCameraUsageDescription</key>
	<string>Taxottic uses the camera so you can photograph receipts and tax documents to attach them to your books.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Taxottic accesses your photo library so you can attach an existing receipt or tax-document image to your books.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Taxottic saves a copy of captured receipts to your photo library when you choose to keep one.</string>
	<!-- Custom URL scheme for the native OAuth handoff. Supabase
	     redirects the in-app browser tab to
	     com.taxottic.app://auth-callback after sign-in; the OS routes
	     that scheme back into the app, Capacitor fires appUrlOpen,
	     and the WebView completes the session. Without this the OAuth
	     session strands in the system browser. The scheme must also
	     be allow-listed in Supabase Auth -> URL Configuration. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.taxottic.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.taxottic.app</string>
			</array>
		</dict>
	</array>
	<!-- Background mileage capture (@capgo/background-geolocation).
	     The app detects drives and logs trip distance for the IRS
	     mileage deduction. iOS hard-crashes + App Review auto-rejects
	     if the Core Location APIs are reachable without these purpose
	     strings, and "always"/background needs UIBackgroundModes:
	     location. Wording is user-facing and states WHY (tax mileage)
	     and that it runs while the app is backgrounded — App Review
	     requires the background justification to be explicit. -->
	<key>NSMotionUsageDescription</key>
	<string>Taxottic uses motion and step activity to tell when a drive has ended (you\u2019ve parked and walked away), so your mileage trips close and appear promptly, and to check afterwards whether a drive was missed while the app was closed.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Taxottic uses your location while you drive to measure trip distance for your IRS mileage tax deduction. You choose whether each trip is business or personal.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Taxottic logs your drives in the background so you never miss a deductible business mile. Location is used only to compute your mileage deduction, sent to your Taxottic account, and never sold or shared. Turn it off any time.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
